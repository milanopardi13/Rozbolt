# Copy to .env.local for local development.
# With no env vars set, local dev login is open (any admin@ email + 4+ char password).

# Admin account (production: required)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (any long random string, 32+ chars)
AUTH_SECRET=

# Optional persistence for admin content edits (choose ONE; first configured wins).
# On Vercel the filesystem is read-only, so without one of these, edits won't survive redeploys.
# 1) Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 2) Vercel Blob
BLOB_READ_WRITE_TOKEN=
